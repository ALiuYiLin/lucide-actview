{
  "name": "@actview/lucide",
  "description": "A Lucide icon library package for ActView applications.",
  "version": "0.0.1",
  "license": "ISC",
  "type": "module",
  "source": "src/lucide-actview.ts",
  "main": "./dist/esm/lucide-actview.mjs",
  "module": "./dist/esm/lucide-actview.mjs",
  "types": "./dist/types/lucide-actview.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lucide-actview.d.ts",
      "import": "./dist/esm/lucide-actview.mjs",
      "default": "./dist/esm/lucide-actview.mjs"
    },
    "./icons": {
      "types": "./dist/types/icons/index.d.ts",
      "import": "./dist/esm/icons/index.mjs",
      "default": "./dist/esm/icons/index.mjs"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "import": "./dist/esm/icons/*.mjs",
      "default": "./dist/esm/icons/*.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && pnpm copy:license && pnpm build:icons && pnpm build:bundles && pnpm build:types",
    "copy:license": "node scripts/copyLicense.mjs",
    "clean": "node scripts/clean.mjs",
    "build:bundles": "rollup -c rollup.config.mjs",
    "build:icons": "node scripts/buildIcons.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build:icons && tsc",
    "test": "pnpm build:icons && vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "actview": "^1.0.29",
    "@actview/jsx": "^1.0.17"
  },
  "devDependencies": {
    "@actview/jsx": "^1.0.17",
    "@actview/testing": "^0.0.3",
    "actview": "^1.0.29",
    "@lucide/build-icons": "workspace:*",
    "@lucide/rollup-plugins": "workspace:*",
    "@lucide/shared": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.20.1",
    "jsdom": "^27.4.0",
    "rollup": "^4.62.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
}
